# CloudBack 后端环境变量
# 复制本文件为 .env 并按你的环境修改（.env 已被 .gitignore 忽略）
#
# Spring Boot 启动时自动从工作目录向上查找并加载 .env
# 在项目根目录（CloudBack/）执行 mvn 命令即可
#
# 支持 ${KEY} 引用其他变量，修改 VM_HOST 即可一键切换

# VM 宿主机 IP（改这一个，下面所有地址跟着变）
VM_HOST=localhost

# MySQL（宿主机已安装）
MYSQL_ADDR=${VM_HOST}:3306
MYSQL_USER=root
# 必填：MySQL 密码（docker-compose 中 Nacos 数据源也引用它）
MYSQL_PASSWORD=

# Redis（宿主机已安装）
REDIS_ADDR=${VM_HOST}
REDIS_PORT=6379
# 必填：Redis 密码
REDIS_PASSWORD=

# Nacos（Docker）
NACOS_ADDR=${VM_HOST}:8848
# 必填：Nacos 认证（Base64 编码的 32 字节以上密钥用于 NACOS_AUTH_TOKEN）
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_AUTH_TOKEN=

# Sentinel（Docker）
SENTINEL_ADDR=${VM_HOST}:8858
# 必填：Sentinel 控制台登录账号
SENTINEL_DASHBOARD_AUTH_USERNAME=
SENTINEL_DASHBOARD_AUTH_PASSWORD=

# Kafka（Docker）
KAFKA_ADDR=${VM_HOST}:9092

# MinIO 对象存储（Docker）
# 必填：MINIO_USER/MINIO_PASSWORD 为 docker-compose 的 root 账号
MINIO_USER=
MINIO_PASSWORD=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# 支付宝沙箱
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# JWT 密钥（至少 256 位）
JWT_SECRET=

# Meilisearch 搜索引擎（Docker）
MEILI_HOST=
MEILI_PORT=
# 必填：Meilisearch master key
MEILI_MASTER_KEY=

# 服务间内部认证 Token（网关与所有下游服务必须一致，建议随机长字符串）
# 必填：留空时 common 的 InternalAuthFilter 会放行并记录 WARN，即下游服务鉴权与内部接口保护不生效
CLOUD_INTERNAL_TOKEN=

# 网关 CORS 允许来源（逗号分隔；frontend dev=5173，npm run preview=4173）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
